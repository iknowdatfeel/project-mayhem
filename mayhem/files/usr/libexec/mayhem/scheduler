#!/bin/sh
# Mayhem: background jobs. Every minute downloads what is due: subscriptions,
# geo data (missing categories at once, the rest nightly) and rule lists;
# reloads the service when something changed (in the background, see
# downloads()). A reload only restarts xray
# when its generated config or the geo files it uses really changed.
# Then checks the tunnels, runs the watchdog (xray memory, dnsmasq), gives
# xray's freed memory back to the system and, when
# turned on, the nightly update of Mayhem itself. Fallback chains of servers
# are checked every 20 seconds, and so are the servers and the remote DNS
# (health.uc: direct while they do not answer, unless the kill switch is on).

. "${MAYHEM_LIB_DIR:-/usr/share/mayhem}/lib.sh"

# Downloads (subscriptions, geo data, rule lists) and the reload after them.
# They take minutes on a slow link or a big geo file: in the background, one
# run at a time, so the checks below keep their 20 s (a dead server waited
# for the downloads before). No reload once the scheduler is gone: the
# service was stopped meanwhile.
downloads() {
	local reload=0 sub_pid="" upd_pid=""
	trap '[ -n "$sub_pid" ] && kill "$sub_pid" 2>/dev/null; [ -n "$upd_pid" ] && kill "$upd_pid" 2>/dev/null; exit 0' TERM INT

	ucode "$MAYHEM_SUB" update --no-wait >/dev/null 2>&1 &
	sub_pid=$!
	wait "$sub_pid"
	local sub_rc=$?
	sub_pid=""
	if [ "$sub_rc" = 3 ]; then
		mayhem_log "subscriptions changed, applying the new servers"
		reload=1
	fi

	ucode "$MAYHEM_UPDATE" due >/dev/null 2>&1 &
	upd_pid=$!
	wait "$upd_pid"
	local upd_rc=$?
	upd_pid=""
	if [ "$upd_rc" = 3 ]; then
		mayhem_log "geo data or rule lists changed, applying them"
		reload=1
	fi

	[ "$reload" = 1 ] && kill -0 "$1" 2>/dev/null && /etc/init.d/mayhem reload
}

dl_pid=""
nap_pid=""
on_term() {
	if [ -n "$dl_pid" ]; then
		if command -v pgrep >/dev/null 2>&1; then
			for cpid in $(pgrep -P "$dl_pid" 2>/dev/null); do
				kill "$cpid" 2>/dev/null
			done
		fi
		kill "$dl_pid" 2>/dev/null
	fi
	[ -n "$nap_pid" ] && kill "$nap_pid" 2>/dev/null
	exit 0
}
trap on_term TERM INT

# sh runs the trap only once a command in the foreground is done: a plain
# sleep 20 held the TERM of a stop until procd killed the scheduler (and its
# downloads) 5 s later. wait returns at once.
nap() {
	sleep "$1" &
	nap_pid=$!
	wait "$nap_pid"
	nap_pid=""
}

# A check that hangs (a stuck xray, a server that holds a connection) must
# not hold the loop: the watchdog that restarts such an xray runs in it too.
bounded() {
	if command -v timeout >/dev/null 2>&1; then
		timeout "$@"
	else
		shift
		"$@"
	fi
}

nap 10

tick=0

while :; do
	if [ $((tick % 3)) = 0 ]; then
		if [ -z "$dl_pid" ] || ! kill -0 "$dl_pid" 2>/dev/null; then
			downloads "$$" &
			dl_pid=$!
		fi

		mayhem_tunnels_check
		mayhem_watchdog
		mayhem_mem_trim
		mayhem_conn_fold
		mayhem_auto_update
		mayhem_dns_catchup
	fi

	# Only when a section has a chain: a ucode process costs a little.
	# MAYHEM_TICK: a server that answered fallback.uc is not asked again by
	# health.uc in the same run (mayhem.check).
	grep -q '"mode": *"fallback"' "$MAYHEM_RUN_DIR/nodes.json" 2>/dev/null &&
		bounded 90 env MAYHEM_TICK="$$.$tick" ucode "$MAYHEM_LIB_DIR/fallback.uc" >/dev/null 2>&1

	# Sections and remote DNS that stop answering go direct and come back
	# (kill switch off), or get back from direct (kill switch on).
	[ -f "$MAYHEM_RUN_DIR/active" ] &&
		bounded 120 env MAYHEM_TICK="$$.$tick" ucode "$MAYHEM_LIB_DIR/health.uc" >/dev/null 2>&1

	tick=$((tick + 1))
	nap 20
done
