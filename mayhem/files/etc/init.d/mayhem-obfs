#!/bin/sh /etc/rc.common
# Mayhem: WireGuard obfuscators, one per tunnel that has one ("config obfs" in
# /etc/config/mayhem). The tunnel sends its UDP to 127.0.0.1:<lport>; the
# obfuscator carries it to <host>:<port>:
#   phobos   wg-obfuscator with the key and masking of the tunnel;
#   faketcp  phantun as TCP, through a TUN device (mhftN, 10.255.N.0/30) that
#            the WAN masquerades (firewall zone mayhem_ft).
# It runs whether routing is on or not: the tunnel needs it either way.

START=19
STOP=90
USE_PROCD=1

OBFS_DIR="${MAYHEM_OBFS_DIR:-/usr/libexec/mayhem}"
RUN_DIR="${MAYHEM_RUN_DIR:-/var/run/mayhem}"
N=0

obfs_instance() {
	local sid="$1" iface kind host port lport key masking conf

	config_get iface "$sid" iface
	config_get kind "$sid" kind
	config_get host "$sid" host
	config_get port "$sid" port
	config_get lport "$sid" lport
	config_get key "$sid" key
	config_get masking "$sid" masking AUTO

	[ -n "$iface" ] && [ -n "$host" ] && [ -n "$port" ] && [ -n "$lport" ] || return 0

	# The server, never the router itself: a .conf made for a local
	# obfuscator has 127.0.0.1 as its endpoint, and the obfuscator would
	# send to itself.
	case "$host" in
		127.*|localhost|::1) logger -t mayhem -p daemon.warn -- "obfuscator of $iface: no server address (it is $host)"; return 0 ;;
	esac

	case "$kind" in
	phobos)
		[ -x "$OBFS_DIR/wg-obfuscator" ] && [ -n "$key" ] || return 0

		# The key goes into a file: the command line is seen by every process.
		# resolve-interval: a server name that cannot be resolved yet (on
		# boot) is tried again instead of the obfuscator quitting, and a
		# changed address is followed. in-timeout: nothing from the server
		# for 90 s while the tunnel sends (keepalives included) - a new
		# session from a new source port, in case the old one was blocked.
		mkdir -p "$RUN_DIR"
		conf="$RUN_DIR/obfs-$iface.conf"
		umask 077
		cat > "$conf" <<CONF
[main]
source-if = 127.0.0.1
source-lport = $lport
target = $host:$port
key = $key
masking = $masking
verbose = WARN
resolve-interval = 300
in-timeout = 90
CONF
		procd_open_instance "$iface"
		procd_set_param command "$OBFS_DIR/wg-obfuscator" -c "$conf"
		;;
	faketcp)
		[ -x "$OBFS_DIR/phantun_client" ] || return 0

		procd_open_instance "$iface"
		procd_set_param command "$OBFS_DIR/phantun_client" --local "127.0.0.1:$lport" --remote "$host:$port" \
			--tun "mhft$N" --tun-local "10.255.$N.1" --tun-peer "10.255.$N.2" --ipv4-only
		procd_set_param env RUST_LOG=warn
		N=$((N + 1))
		;;
	*)
		return 0
		;;
	esac

	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

start_service() {
	config_load mayhem
	config_foreach obfs_instance obfs
}

service_triggers() {
	procd_add_reload_trigger mayhem
}
