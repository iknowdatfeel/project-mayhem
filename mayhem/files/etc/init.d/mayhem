#!/bin/sh /etc/rc.common
# Mayhem: xray-based traffic routing.

START=99
STOP=10
USE_PROCD=1

. /usr/share/mayhem/lib.sh

# While the service (re)starts, a file applying.<pid> tells the dashboard
# that what it shows is about to change.
start_service() {
	local f rc

	mkdir -p "$MAYHEM_RUN_DIR"
	f="$MAYHEM_RUN_DIR/applying.$$"
	: > "$f"
	mayhem_start
	rc=$?
	rm -f "$f"
	return $rc
}

mayhem_start() {
	local enabled conflicts

	config_load mayhem
	config_get_bool enabled settings enabled 0

	if [ "$enabled" != 1 ]; then
		mayhem_net_down
		mayhem_dns_down
		return 0
	fi

	if [ ! -x "$MAYHEM_XRAY_BIN" ]; then
		mayhem_log "xray is not installed, run: mayhem xray-install" err
		return 1
	fi

	conflicts="$(mayhem_conflicts)"
	if [ -n "$conflicts" ]; then
		mayhem_log "not starting: another traffic interceptor is running ($conflicts)" err
		mkdir -p "$MAYHEM_RUN_DIR"
		printf '{"ok":false,"errors":["another traffic interceptor is running: %s"]}\n' \
			"$conflicts" > "$MAYHEM_RUN_DIR/status.json"
		return 1
	fi

	if ! ucode "$MAYHEM_GEN"; then
		mayhem_log "not starting: configuration has errors (mayhem check)" err
		return 1
	fi

	. "$MAYHEM_RUN_DIR/env"

	# New servers and routing go into running xray without a restart when
	# nothing else changed; if that fails, the key changes and procd
	# restarts xray. New firewall rules go in place the same way.
	mayhem_live_update
	mayhem_net_refresh

	# dnsmasq gets Mayhem's file once (restarted only when it changed).
	mayhem_dns_up

	procd_open_instance xray
	procd_set_param command /usr/libexec/mayhem/xray-run
	procd_set_param env GOMEMLIMIT="$GOMEMLIMIT" GOGC="${GOGC:-100}" MAYHEM_IPV6="$MAYHEM_IPV6" XRAY_LOCATION_ASSET="$XRAY_LOCATION_ASSET"
	# procd restarts xray on reload only when these files changed: the config
	# without the servers and the routing, the geo files.
	procd_set_param file "$MAYHEM_RUN_DIR/xray.key" "$MAYHEM_RUN_DIR/geo.stamp"
	procd_set_param respawn 3600 5 0
	procd_set_param term_timeout 10
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	procd_open_instance scheduler
	procd_set_param command /usr/libexec/mayhem/scheduler
	procd_set_param respawn 3600 30 0
	procd_close_instance
}

stop_service() {
	mayhem_net_down
	mayhem_dns_down
	rm -f "$MAYHEM_RUN_DIR/health.json" "$MAYHEM_RUN_DIR/dns.degraded"
}

service_triggers() {
	procd_add_reload_trigger mayhem
	# Provider DNS servers may change with the WAN lease.
	procd_add_interface_trigger "interface.*.up" wan /etc/init.d/mayhem reload
}
