#!/bin/sh /etc/rc.common
# Mayhem: xray-based traffic routing.

START=99
STOP=10
USE_PROCD=1

. /usr/share/mayhem/lib.sh

# While the service (re)starts, a file applying.<pid> tells the dashboard
# that what it shows is about to change. One start or reload at a time: a
# second one (the WAN came up during the first after boot, two changes saved
# at once) waits and then reads what is new, instead of both writing the
# generated files and the older state winning.
start_service() {
	local f rc

	mkdir -p "$MAYHEM_RUN_DIR"
	f="$MAYHEM_RUN_DIR/applying.$$"
	: > "$f"
	mayhem_lock start
	mayhem_start
	rc=$?
	mayhem_unlock start
	rm -f "$f"
	return $rc
}

# Is xray of a previous start running?
mayhem_xray_running() {
	local pid

	pid="$(cat "$MAYHEM_RUN_DIR/xray.pid" 2>/dev/null)"
	[ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && [ -f "$MAYHEM_RUN_DIR/running.xray.json" ]
}

# xray and the scheduler as procd instances.
mayhem_instances() {
	procd_open_instance xray
	procd_set_param command /usr/libexec/mayhem/xray-run
	procd_set_param env GOMEMLIMIT="$GOMEMLIMIT" GOGC="${GOGC:-100}" MAYHEM_IPV6="$MAYHEM_IPV6" XRAY_LOCATION_ASSET="$XRAY_LOCATION_ASSET"
	# procd restarts xray on reload only when these files changed: the config
	# without the servers and the routing, the geo files.
	procd_set_param file "$MAYHEM_RUN_DIR/xray.key" "$MAYHEM_RUN_DIR/geo.stamp"
	procd_set_param respawn 3600 5 0
	procd_set_param term_timeout 10
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	procd_open_instance scheduler
	procd_set_param command /usr/libexec/mayhem/scheduler
	procd_set_param respawn 3600 30 0
	procd_close_instance
}

mayhem_start() {
	local enabled conflicts

	config_load mayhem
	config_get_bool enabled settings enabled 0

	if [ "$enabled" != 1 ]; then
		mayhem_net_down
		mayhem_dns_down
		return 0
	fi

	if [ ! -x "$MAYHEM_XRAY_BIN" ]; then
		mayhem_log "xray is not installed, run: mayhem xray-install" err
		mayhem_restart_failed
		return 1
	fi

	conflicts="$(mayhem_conflicts)"
	if [ -n "$conflicts" ]; then
		mayhem_log "not starting: another traffic interceptor is running ($conflicts)" err
		mkdir -p "$MAYHEM_RUN_DIR"
		printf '{"ok":false,"errors":["another traffic interceptor is running: %s"]}\n' \
			"$conflicts" > "$MAYHEM_RUN_DIR/status.json"
		mayhem_restart_failed
		return 1
	fi

	if ! ucode "$MAYHEM_GEN"; then
		# A reload with errors leaves running xray on the configuration it
		# has: without instances procd would stop it, and Mayhem would be
		# off until the next good reload. The dashboard shows the errors.
		if mayhem_xray_running && [ -f "$MAYHEM_RUN_DIR/env" ]; then
			mayhem_log "configuration has errors (mayhem check), xray keeps the previous one" err
			. "$MAYHEM_RUN_DIR/env"
			mayhem_instances
			return 1
		fi

		mayhem_log "not starting: configuration has errors (mayhem check)" err
		mayhem_restart_failed
		return 1
	fi

	. "$MAYHEM_RUN_DIR/env"

	# New servers and routing go into running xray without a restart when
	# nothing else changed; if that fails, the key changes and procd
	# restarts xray. New firewall rules go in place the same way.
	mayhem_live_update
	mayhem_net_refresh

	# What procd is about to restart xray for, for the dashboard.
	mayhem_restart_reason

	# dnsmasq gets Mayhem's file once (restarted only when it changed).
	mayhem_dns_up

	# Subscriptions added or given a new address are downloaded now, not on
	# the scheduler's next run.
	mayhem_subs_new

	# The firewall rules and dnsmasq's file for the other choices of a server
	# list with tunnels, built while xray works.
	mayhem_net_warm

	mayhem_instances
}

stop_service() {
	mayhem_net_down

	# A restart keeps Mayhem's file in dnsmasq's conf-dir: dnsmasq restarted
	# without it here and with it again on start, and with an ad list each
	# restart reads tens of thousands of names (seconds on a router). The
	# provider's servers until the new xray listens (a SIGHUP), like after a
	# crash; the start puts in a new file only when it changed.
	if [ "$MAYHEM_RESTART" = 1 ]; then
		mayhem_dns_servers isp
	else
		mayhem_dns_down
	fi

	# Nothing is redirected from here on, also before xray-run sees it go.
	rm -f "$MAYHEM_RUN_DIR/health.json" "$MAYHEM_RUN_DIR/dns.degraded" "$MAYHEM_RUN_DIR/active"
}

# A restart that does not start again takes Mayhem's file out of dnsmasq,
# as a stop does.
mayhem_restart_failed() {
	[ "$MAYHEM_RESTART" = 1 ] && mayhem_dns_down
	return 0
}

restart() {
	MAYHEM_RESTART=1
	trap '' TERM
	stop "$@"
	trap - TERM
	start "$@"
}

service_triggers() {
	procd_add_reload_trigger mayhem
	# Provider DNS servers may change with the WAN lease.
	procd_add_interface_trigger "interface.*.up" wan /etc/init.d/mayhem reload
}
