config section 'main'
	option enabled '1'
	option type 'proxy'
	option proxy_type 'link'
	# one link per entry; servers of subscriptions can be added too
	# list link 'vless://...'
	# list subscription 'mysub'
	# option filter 'NL|DE'         # take only servers whose names match
	# option exclude ''
	# auto: fastest by URL test, manual: the one chosen on the dashboard
	option select 'auto'
