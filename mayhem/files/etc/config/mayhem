
config settings 'settings'
	option enabled '0'
	# lists: only matched traffic goes to sections, the rest goes direct
	# global: everything goes to default_section except exclusions
	option mode 'lists'
	# the main section, chosen on the dashboard: the rest of the traffic
	# (global), remote DNS and downloads through Xray; empty = the first
	# proxy section
	option default_section ''
	list interface 'br-lan'
	# local addresses (10/8, 192.168/16...) are never routed
	option exclude_local '1'
	# drop QUIC (UDP 443): browsers fall back to TCP
	option block_quic '0'
	# BitTorrent goes direct
	option torrent_direct '0'
	# prefer_ipv4 | prefer_ipv6 | ipv4_only | ipv6_only
	option ip_family 'prefer_ipv4'
	# debug | info | warning | error | none
	option log_level 'warning'
	# xray soft memory limit in MiB, empty = 1/4 of RAM
	option memlimit ''
	# Mux for every VLESS node (Vision nodes only multiplex UDP)
	option mux '0'
	option mux_concurrency '8'
	option mux_xudp_concurrency '16'
	option mux_xudp_udp443 'reject'
	# watchdog: restart xray when it uses more than watchdog_mem % of RAM
	# for 3 minutes; restart dnsmasq when it is gone
	option watchdog '1'
	option watchdog_mem '40'
	# automatic server choice: how often and with which URL servers are checked
	option probe_url 'https://www.gstatic.com/generate_204'
	option probe_interval '3m'
	# install new releases of Mayhem nightly (at geo.update_hour)
	option auto_update '0'

config dns 'dns'
	# empty = DNS servers received from the provider on WAN
	# list domestic '77.88.8.8'
	# the first server is the main one, the rest are fallbacks
	list remote 'https://1.1.1.1/dns-query'
	list remote 'https://8.8.8.8/dns-query'
	option fakedns '0'
	option hijack '1'
	# remote DNS through the active server of the main section (0 = direct DoH)
	option via_proxy '1'

# Geo data: geosite/geoip files are read on the router as they download and
# only the categories that sections use are kept in /etc/mayhem/geo.
config geo 'geo'
	# hour of the nightly update (router time)
	option update_hour '4'
	# download through Xray (the active server), direct if that fails
	option via_xray '1'
	# rule lists from URLs are refreshed every N hours
	option lists_interval '24'

config geo_source 'rf_geosite'
	option enabled '1'
	option kind 'geosite'
	option url 'https://github.com/runetfreedom/russia-v2ray-rules-dat/releases/latest/download/geosite.dat'

config geo_source 'rf_geoip'
	option enabled '1'
	option kind 'geoip'
	option url 'https://github.com/runetfreedom/russia-v2ray-rules-dat/releases/latest/download/geoip.dat'

# How subscription requests present the router (Happ-compatible headers).
# hwid and model are filled in on install.
config device 'device'
	option user_agent 'Happ/3.13.0'
	option os 'Android'
	option os_version '14'
	option locale 'ru'

# config subscription 'mysub'
#	option enabled '1'
#	option url 'https://example.com/sub/token'
#	option update_interval '12'     # hours
#	option via_xray '1'             # through Xray (the active server), direct if that fails
#	option send_hwid '1'

# The server list: servers added by key and the servers of every enabled
# subscription. Its active server (chosen on the dashboard) carries proxy
# sections that have no servers of their own, remote DNS and downloads.
config pool 'pool'
	# list link 'vless://...'
	# auto: fastest by URL test, manual: the one chosen on the dashboard
	option select 'auto'

# Sections are routing rules. A proxy section uses the active server of the
# server list; with servers 'own' it has servers of its own (links,
# subscriptions, filters) for its domains.
config section 'main'
	option enabled '1'
	option type 'proxy'
	# option servers 'own'
	# list link 'vless://...'
	# list subscription 'mysub'
	# rules: example.com, full:, keyword:, regexp:, geosite:youtube, geosite:SOURCE:CATEGORY
	# list domain 'geosite:youtube'
	# list ip 'geoip:telegram'
	# lists with one rule per line, from URLs (refreshed) or files on the router
	# list list_url 'https://example.com/list.lst'
	# list list_file '/etc/mayhem/my.lst'
	# option filter 'NL|DE'         # take only servers whose names match
	# option exclude ''
	# auto: fastest by URL test, manual: the one chosen on the dashboard
	option select 'auto'
